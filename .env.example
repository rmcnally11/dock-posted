# Optional. Defaults to data/runtime locally, or /tmp/dock-posted on Vercel
# when Blob is not configured.
# DATA_DIR=/tmp/dock-posted

# Vercel Blob — injected when you create a Blob store on this project
# and connect it (Vercel → Storage → Blob). Needed for reports to
# survive deploys. Local `npm run dev` does not need this.
# BLOB_READ_WRITE_TOKEN=

# Internal /wholesale desk. If WHOLESALE_PASSWORD is unset, /wholesale is 404.
# Placeholders only. Do not commit a real password.
# WHOLESALE_PASSWORD=
# WHOLESALE_SESSION_SECRET=

# Public X handle for the About timeline embed. No @. Defaults to DockPosted.
# NEXT_PUBLIC_X_HANDLE=DockPosted
